{
  "name": "gamifier",
  "version": "1.0.0",
  "description": "Adds XP, levels, score, health, quests and achievements to Ceasy programs.",
  "source": "\"\"\"Gamifier addon: add game-like progression to ordinary Ceasy programs.\"\"\"\nimport random as _random\n\n_title = \"Your Program\"\n_score = 0\n_xp = 0\n_level = 1\n_health = 100\n_max_health = 100\n_achievements = []\n_quests = []\n_started = False\n\n\ndef start(title=\"Your Program\"):\n    global _title, _started\n    _title = str(title)\n    _started = True\n    print(\"\\n=== GAME START: \" + _title + \" ===\")\n    hud()\n\n\ndef _check_level():\n    global _level\n    while _xp >= _level * 100:\n        _level += 1\n        print(\"[LEVEL UP] You reached level \" + str(_level) + \"!\")\n\n\ndef action(description, xp=10):\n    global _score, _xp\n    if not _started:\n        start()\n    reward = max(0, int(xp))\n    _score += reward\n    _xp += reward\n    print(\"[ACTION] \" + str(description) + \"  (+\" + str(reward) + \" XP)\")\n    _check_level()\n    hud()\n\n\ndef add_score(points=10):\n    global _score\n    _score += int(points)\n    print(\"[SCORE] +\" + str(points))\n    hud()\n\n\ndef add_xp(amount=10):\n    global _xp\n    _xp += max(0, int(amount))\n    print(\"[XP] +\" + str(amount))\n    _check_level()\n    hud()\n\n\ndef damage(amount=10):\n    global _health\n    _health = max(0, _health - max(0, int(amount)))\n    print(\"[DAMAGE] -\" + str(amount) + \" HP\")\n    if _health == 0:\n        print(\"[GAME OVER] Health reached zero.\")\n    hud()\n\n\ndef heal(amount=10):\n    global _health\n    _health = min(_max_health, _health + max(0, int(amount)))\n    print(\"[HEAL] +\" + str(amount) + \" HP\")\n    hud()\n\n\ndef achievement(name):\n    name = str(name)\n    if name not in _achievements:\n        _achievements.append(name)\n        print(\"[ACHIEVEMENT UNLOCKED] \" + name)\n\n\ndef quest(name):\n    name = str(name)\n    if name not in _quests:\n        _quests.append(name)\n        print(\"[NEW QUEST] \" + name)\n\n\ndef complete_quest(name, reward=50):\n    name = str(name)\n    if name not in _quests:\n        print(\"[QUEST NOT FOUND] \" + name)\n        return\n    _quests.remove(name)\n    print(\"[QUEST COMPLETE] \" + name)\n    add_xp(reward)\n    achievement(\"Quest completed: \" + name)\n\n\ndef random_reward(minimum=5, maximum=25):\n    reward = _random.randint(int(minimum), int(maximum))\n    add_xp(reward)\n    return reward\n\n\ndef hud():\n    print(\"--- \" + _title + \" ---\")\n    print(\"Level: \" + str(_level) + \" | XP: \" + str(_xp) + \"/\" + str(_level * 100))\n    print(\"Score: \" + str(_score) + \" | Health: \" + str(_health) + \"/\" + str(_max_health))\n    print(\"Quests: \" + str(len(_quests)) + \" | Achievements: \" + str(len(_achievements)))\n\n\ndef status():\n    hud()\n    if _quests:\n        print(\"Active quests: \" + \", \".join(_quests))\n    if _achievements:\n        print(\"Achievements: \" + \", \".join(_achievements))\n\n\ndef end():\n    print(\"\\n=== GAME COMPLETE ===\")\n    status()\n    print(\"Final score: \" + str(_score))\n\n\ndef reset():\n    global _title, _score, _xp, _level, _health, _achievements, _quests, _started\n    _title = \"Your Program\"\n    _score = 0\n    _xp = 0\n    _level = 1\n    _health = _max_health\n    _achievements = []\n    _quests = []\n    _started = False\n    print(\"[GAMIFIER] Progress reset.\")\n"
}
